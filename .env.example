# General Application Configuration
PROJECT_NAME="Singh & Thakur Associates CA Platform"
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security & Tokens (Change in Production)
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cafirm
POSTGRES_PORT=5432

# Optional direct Database URL override (e.g., postgresql://user:password@localhost:5432/cafirm)
# DATABASE_URL=postgresql://postgres:changeme@localhost:5432/cafirm
