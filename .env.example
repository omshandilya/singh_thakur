# ==============================================================================
# SINGH & THAKUR ASSOCIATES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and modify values appropriately for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="Singh & Thakur Associates CA Platform"

# Environment Mode: 'development' | 'production' | 'test'
ENVIRONMENT=development

# API Route Prefix
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (CRITICAL FOR PRODUCTION)
# ------------------------------------------------------------------------------
# In production, generate a cryptographically strong 32+ character random key:
# Example command: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_to_strong_random_string_in_production

# JWT Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. CORS & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend public API endpoint URL (consumed by Next.js browser client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_USER=postgres
# In production, set a strong, unique password:
POSTGRES_PASSWORD=dev_postgres_password_change_in_production
POSTGRES_DB=cafirm
POSTGRES_PORT=5432

# Optional direct connection string override (takes precedence over individual params if set)
# DATABASE_URL=postgresql://postgres:dev_postgres_password_change_in_production@localhost:5432/cafirm
